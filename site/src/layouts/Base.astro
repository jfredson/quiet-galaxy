---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Starfield from '../components/Starfield.astro';
import { records, longDate } from '../lib/records';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'The Quiet Galaxy',
  description = 'Where is everybody? A public explainer and tracker for the Fermi Paradox: the Drake Equation run as a spread of published estimates, every explanation for the silence on its own page, and a dated log of the science that moves the numbers.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentYear = new Date().getFullYear();
const c = records.counts;
const builtFrom = `${c.factors} of the equation's ${c.factors_expected} factors, ${c.explanations} explanation${c.explanations === 1 ? '' : 's'}, ${c.library} library entr${c.library === 1 ? 'y' : 'ies'} and ${c.publications} publication${c.publications === 1 ? '' : 's'}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#08070f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Fredrickson" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Quiet Galaxy" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="space-bg" aria-hidden="true">
      <div class="galaxy"></div>
      <div class="core"></div>
      <Starfield count={150} />
    </div>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">The Quiet Galaxy</span>
          <p class="footer-tag">A public explainer and tracker for the question of why the galaxy looks empty. Every number on this site is computed from the records in the public repository.</p>
          <p class="footer-links">
            <a href="https://github.com/jfredson/quiet-galaxy" rel="noopener">Source on GitHub</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Fredrickson. Last built {longDate(records.exported_on)}{records.commit ? ` (version ${records.commit})` : ''} from {builtFrom}. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
