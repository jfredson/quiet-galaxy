---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Starfield from '../components/Starfield.astro';
import { records, longDate, builtFrom } from '../lib/records';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string; // a page's own preview picture (a news post's card); the site's otherwise
}

const {
  title = 'The Quiet Galaxy',
  description = 'Where is everybody? A public explainer and tracker for the Fermi Paradox: the Drake Equation run as a spread of published estimates, every explanation for the silence on its own page, and a dated log of the science that moves the numbers.',
  noindex = false,
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The preview picture link cards show (site/public/social-preview.png, made by scripts/social-image.mjs); an absolute address, as the tags require.
const socialImage = new URL(image ?? '/social-preview.png', Astro.site).href;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#05070a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Fredrickson" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="The Quiet Galaxy · News" href="/news/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Quiet Galaxy" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Quiet Galaxy: Where is everybody? A public explainer and tracker of the Fermi Paradox." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    {/* The Hush skin's sky (ruled 2026-10-16): a dozen still stars, no glow, no core. */}
    <div class="space-bg" aria-hidden="true">
      <div class="rings"></div>
      <Starfield count={12} />
    </div>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">The Quiet Galaxy</span>
          <p class="footer-tag">A public explainer and tracker for the question of why the galaxy looks empty. Every number on this site is computed from the records in the public repository.</p>
          <p class="footer-links">
            <a href="/equation/">The equation</a>
            <a href="/explanations/">Explanations</a>
            <a href="/library/">Library</a>
            <a href="/reading/">This week's reading</a>
            <a href="/about/">About</a>
            <a href="/about/#method">How the numbers are worked out</a>
            <a href="/about/#story">The story so far</a>
            <a href="/disagree/">Feedback</a>
            <a href="https://github.com/jfredson/quiet-galaxy" rel="noopener">Source on GitHub</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Fredrickson. Last built {longDate(records.exported_on)}{records.commit ? ` (version ${records.commit})` : ''} from {builtFrom()}. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
          <p class="footer-follow"><a href="https://x.com/SentHorizons" rel="noopener">Follow on X</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
