---
// This week's reading: every weekly reading of the records against the news, every verdict
// (docs/weekly-reading.md; tracker pattern, rules 5 and 7). Once a week a fresh session reads each
// factor's "what would move this" line and each explanation's "would strengthen" and "would weaken"
// lines against what was published, logs what bears on them, and writes a record to data/readings/;
// the export script checks it and hands it to this page. Showing all of it, including the weeks
// where nothing happened, lets a reader watch the records being watched instead of taking it on
// faith. Copied from The Belt Equation's radar page (site/src/pages/radar.astro) on 2026-10-16 and
// adapted: four verdicts, items grouped under the seven pieces and then the three families.
// 2026-10-21: the card grid became one column of entries that open and close
// (components/ReadingEntries.astro), with the counts under the heading, as John approved.
import Base from '../../layouts/Base.astro';
import ReadingEntries from '../../components/ReadingEntries.astro';
import { longDate } from '../../lib/records';
import {
  readings, latestReading, waitingOnMe, readingCounts, verdictLabel, verdictMeaning, readingSummary,
  readingCountLine, plainCount, ranAtLabel, runByLabel, VERDICT_ORDER,
} from '../../lib/readings';

const older = readings.slice(1);

const description = latestReading
  ? `The Quiet Galaxy's weekly reading of its records against the news: ${readingSummary(latestReading)} on ${longDate(latestReading.date)}. Every record read, what was searched, what was found, and the verdict.`
  : "The Quiet Galaxy's weekly reading of its records against the news. The first reading has not run yet.";
---

<Base title="This week's reading · The Quiet Galaxy" description={description}>
  <section class="hero">
    <p class="eyebrow">This week's reading</p>
    <h1>Every piece and every explanation, read against the news each week</h1>
    {latestReading && <p class="reading-count-line">Latest reading, <a href={`#${latestReading.id}`}>{longDate(latestReading.date)}</a>: {readingCountLine(latestReading)}</p>}
    <p class="lede">
      Each of the seven pieces of the equation says what kind of discovery would move its range, and each explanation says what would strengthen or weaken it. Once a week a fresh session searches for what was published against each of those lines and writes down what it found, whether or not anything moved.
    </p>
    <p class="dim" style="font-size: 14px;">
      Every paper that bears on a record is logged in <a href="/about/#story">the story so far</a>. The reading may move one end of a piece's range by a small step with a published number behind it; anything beyond that, it leaves for me and says so. Each reading is a file in the repository, written once and never edited, and the site refuses to build if one of them does not add up.
    </p>
  </section>

  {!latestReading && (
    <section class="section narrow">
      <div class="callout">
        <h3>No reading yet</h3>
        <p>
          The first weekly reading has not run. When it does, this page fills with what it read and what it found.
          The procedure it follows is in the repository, at <code>docs/weekly-reading.md</code>.
        </p>
      </div>
    </section>
  )}

  {latestReading && (
    <section class="section" id={latestReading.id}>
      <div class="shead">
        <h2>The latest reading</h2>
        <span>{longDate(latestReading.date)}, by {runByLabel[latestReading.run_by]}</span>
      </div>

      <div class="scan-head">
        <div class="scan-facts">
          <p class="scan-line">{readingSummary(latestReading)}.</p>
          <p class="dim scan-meta">
            {latestReading.searches} searches across {latestReading.records_read} record{latestReading.records_read === 1 ? '' : 's'},
            read against the records as they stood that day (<a href={`https://github.com/jfredson/quiet-galaxy/tree/${latestReading.commit_before}`} rel="noopener">this version</a>). The run finished {ranAtLabel(latestReading)}.
            {latestReading.window && <> Window: {latestReading.window}</>}
            {latestReading.pages_opened && <> Pages opened: {latestReading.pages_opened}</>}
            {latestReading.limits && <> What it could not see: {latestReading.limits}</>}
            {' '}The record is <code>{latestReading.file}</code>.
          </p>
        </div>
      </div>

      {waitingOnMe.length > 0 && (
        <div class="waiting">
          <h3>Waiting on me</h3>
          <p class="dim">
            {plainCount(waitingOnMe.length)} thing{waitingOnMe.length === 1 ? '' : 's'} the reading found and was not allowed to act on by
            itself. Each stays on this list until a later reading reads that record again, or a ruling is recorded on the record.
          </p>
          <ul class="waiting-list">
            {waitingOnMe.map((w) => (
              <li>
                <a href={w.path}>{w.name}</a>
                <span class="dim"> · {w.family_name} · flagged {w.reading_date}</span>
                <p>{w.for_john}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="reading-tally">Entries with nothing new are closed; open one to see its full note and its searches.</p>
      <ReadingEntries reading={latestReading} full />

      <div class="verdict-key">
        <h3>What the four verdicts mean</h3>
        <dl>
          {VERDICT_ORDER.map((v) => (
            <>
              <dt><span class={`badge v-${v}`}>{verdictLabel[v]}</span></dt>
              <dd>{verdictMeaning[v]}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>
  )}

  {older.length > 0 && (
    <section class="section">
      <div class="shead"><h2>Earlier readings</h2><span>{older.length} of them, newest first</span></div>
      {older.map((reading) => (
        <details class="old-scan" id={reading.id}>
          <summary>
            <span class="old-date">{reading.date}</span>
            <span class="old-sum">{readingSummary(reading)}</span>
            {reading.run_by === 'hand' && <span class="badge v-test">By hand</span>}
          </summary>
          <div class="old-body">
            <ReadingEntries reading={reading} />
          </div>
        </details>
      ))}
    </section>
  )}

  <p class="dim home-meta">
    {readingCounts.readings === 0
      ? 'No reading has run yet.'
      : `${readingCounts.readings} reading${readingCounts.readings === 1 ? '' : 's'} on the record, ${readingCounts.items} record check${readingCounts.items === 1 ? '' : 's'} in all${readingCounts.by_hand ? `, ${readingCounts.by_hand} of the readings run by hand` : ''}.`}
    <span class="sep">|</span><a href="/equation/">The equation</a><span class="sep">|</span><a href="/about/#story">The story so far</a>
  </p>
</Base>
