---
// The home page: the trunk of the tracker (design/tracker-pattern.md, section 1, ruled by John
// 2026-10-16). The first screen is built like The Belt Equation's (the ruled reference): two
// columns on a desktop, stacked on a phone. Swapped on 2026-10-16 at John's asking: the equation
// line, the trunk's picture, sits in the wide left column where its seven terms fit on one row,
// each a link to its piece's page with a plain name and the range this site uses under it (rule
// 2.4), placed after the question and its paragraph at John's asking later the same evening; the thing held sits in the box on the right, in the largest type on the site: the chance
// that there are other detectable civilisations in the galaxy (John's wording, 2026-10-16; the
// same chance the other way round from the earlier "alone" figure), with the observable-universe
// chance and the middle estimate beneath it. Then, on the left: the question as the title; one
// paragraph for a newcomer; the width of the argument in one line; the last-checked strip; two
// buttons. On a phone the box comes first. No control on the first screen:
// the calculator lives on the equation page (rule 1.4). Until the run exists, every number reads
// "not computed yet" in words, never a placeholder digit. The big number, the strip and the
// equation line are copied from The Belt Equation's home page (site/src/pages/index.astro there).
import Base from '../layouts/Base.astro';
import { records, longDate, plainNumber, percent, rangeText, plural, symbolHtml, medianWords } from '../lib/records';
import { latestReading, readingSummary } from '../lib/readings';

const head = records.headline;
const c = records.counts;
const factors = records.factors;
const written = factors.filter((f) => f.exists).length;
const width = head.available && head.optimist !== undefined && head.pessimist !== undefined
  ? { optimist: head.optimist, pessimist: head.pessimist }
  : null;
const NOT_YET = 'not computed yet';
// The last-checked strip (tracker pattern, rule 5.2; copied from The Belt Equation's scan strip):
// one line saying when the records were last read against the news and what came of it. When
// exactly one range moved, the line names the piece; otherwise the reading page has the detail.
const loneMover = latestReading && latestReading.moved.length === 1 ? latestReading.moved[0] : null;
// Short plain names under each term of the equation on the first screen (the full names are on
// the equation page and in each term's title).
const SHORT: Record<string, string> = {
  'star-formation': 'stars born each year',
  'planets': 'share with planets',
  'habitable-planets': 'planets that could host life',
  'life': 'share where life starts',
  'intelligence': 'share that gets intelligent',
  'detectable': 'share that is detectable',
  'lifetime': 'years it stays detectable',
};
---

<Base>
  <section class="home-hero">
    <div class="home-hero-main">
      <p class="eyebrow">A public explainer and tracker of the Fermi Paradox</p>
      <h1 class="big-claim">Where is everybody?</h1>
      <p class="big-sub">
        The physicist Enrico Fermi asked that over lunch in 1950: the galaxy is old enough and big enough that someone should have shown up by now, and nobody has. This site takes the question apart, piece by piece, and keeps every serious answer to it on a page of its own.
      </p>
      <div class="trunk" id="pieces">
        <p class="trunk-label">The seven pieces the number comes from</p>
        <p class="trunk-eq" aria-label="The equation">
          <span class="trunk-n">N</span><span class="op">=</span>
          {factors.map((f, i) => (
            <>
              <a class={`trunk-term ${f.range ? '' : 'missing'}`} href={f.path} title={f.name}>
                <span class="trunk-sym" set:html={symbolHtml(f.symbol)}></span>
                <span class="trunk-name">{SHORT[f.id] ?? f.name}</span>
                <span class="trunk-range">{f.range ? rangeText(f.range, f.unit, true) : 'no range yet'}</span>
              </a>
              {i < factors.length - 1 && <span class="op">×</span>}
            </>
          ))}
        </p>
        <p class="trunk-foot">N is how many civilisations in our galaxy could be detected right now. Each piece is a range drawn from what has been published; the number on the right comes from multiplying the seven many thousands of times with a random pick from each, and is never typed in. <a href="/equation/#calculator">Try the numbers yourself</a>.</p>
      </div>
      <p class="width-line">
        {width
          ? <>Take every optimistic published estimate and you get <strong>{plainNumber(width.optimist)}</strong> civilisations in the galaxy; every pessimistic one and you get <strong>{plainNumber(width.pessimist)}</strong>. That gap is the argument.</>
          : <>Take every optimistic published estimate and you get one number; every pessimistic one and you get another. That gap is the argument, and both numbers are {NOT_YET}.</>}
      </p>
      <p class="scan-strip">
        <span class="strip-dot" aria-hidden="true"></span>
        {latestReading ? (
          <span>
            Last checked {longDate(latestReading.date)}{!latestReading.pages_opened && ', by a news-style web search of the window (the preprint listing was not checked)'}: {readingSummary(latestReading)}{loneMover ? <>: <a href={loneMover.path}>{loneMover.name}</a></> : ''}.
            {' '}<a href="/reading/">See the week's reading</a>.
            {latestReading.run_by === 'hand' && <span class="strip-test">This one was run by hand, before the weekly task started.</span>}
          </span>
        ) : (
          <span>
            No weekly reading of the records against the news has run yet. The records were last changed on {longDate(records.exported_on)}: {written} of the seven pieces written up, {plural(c.explanations, 'explanation', 'explanations')}, {plural(c.publications, 'paper logged', 'papers logged')}.
            {' '}<a href="/story/">See the story so far</a>.
          </span>
        )}
      </p>
      <div class="ctas">
        <a class="btn" href="/equation/">Why so uncertain?</a>
        <a class="btn ghost" href="/method/#who">Who is asking</a>
      </div>
    </div>

    <aside class="home-number" aria-label="The answer so far">
      <p class="number-label">The answer so far</p>
      <p class={`big-number ${head.available ? '' : 'pending'}`}>{head.available ? percent(1 - head.alone_galaxy) : NOT_YET}</p>
      <p class="big-claim-line">The chance that there are other detectable civilisations in our galaxy right now.</p>
      <p class="under-number">
        <span><strong>{head.available ? percent(1 - head.alone_universe) : NOT_YET}</strong> the chance there are others somewhere in the observable universe</span>
        <span>{head.available ? <><strong>{plainNumber(head.median)}</strong> detectable civilisations in our galaxy at the middle of the spread: {medianWords(head.median).replace(/^about one detectable civilisation/, 'one')}</> : <><strong>{NOT_YET}</strong> detectable civilisations in our galaxy at the middle of the spread</>}</span>
      </p>
      <p class="number-foot">{head.available ? <>Played out {plainNumber(head.runs ?? 0)} times from the seven ranges. {head.any_range_first_pass ? 'Every range is a first pass until the outside review has run.' : ''}</> : <>The number appears once the seven pieces have ranges.</>}</p>
    </aside>
  </section>

  <section class="section" id="explanations">
    <div class="shead">
      <h2>Every serious explanation for the silence</h2>
      <span>{plural(c.explanations, 'so far', 'so far')}, in three families</span>
    </div>
    <div class="families-home">
      {records.families.map((fam) => (
        <a class="family-card" href={`/explanations/#${fam.key}`}>
          <h3>{fam.name}</h3>
          <p>{fam.blurb}</p>
          <span class="count">{plural(fam.count, 'explanation', 'explanations')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section moves">
    <div class="move">
      <p class="kicker">What would move it</p>
      <p>A planet with signs of life in its air, or a survey that finds none on hundreds of them. The two pieces we know least about are whether life starts at all and whether it becomes intelligent; everything else is a detail beside those. Each piece's page says what discovery would narrow its range.</p>
      <a class="btn ghost" href="/equation/">See the seven pieces</a>
    </div>
    <div class="move">
      <p class="kicker">What has changed</p>
      <p>Every paper and discovery that bears on the numbers is logged with its date, which piece it touches, and whether it moved a range. The log reaches back to the founding papers of the 1960s and forward to whatever is published next.</p>
      <a class="btn ghost" href="/story/">Read the story so far</a>
    </div>
    <div class="move">
      <p class="kicker">Think a number here is wrong?</p>
      <p>Every piece has a page, every estimate a source, and every explanation a statement of what would strengthen or weaken it. Name a missing explanation, argue a range with a source, or point out an error, and the change lands with a dated line.</p>
      <a class="btn ghost" href="/disagree/">Here's how to tell me, and what happens next</a>
    </div>
  </section>

  <p class="dim home-meta">
    Records as of {longDate(records.exported_on)}. Everything on this site is built from a public repository, <a href="https://github.com/jfredson/quiet-galaxy" rel="noopener">on GitHub</a>, where every number carries its source and every change its date.
    <span class="sep">|</span><a href="/method/">How the numbers are worked out</a><span class="sep">|</span><a href="/library/">Books and films that take the question seriously</a>
  </p>
</Base>
