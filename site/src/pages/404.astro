---
import Base from '../layouts/Base.astro';
import { records } from '../lib/records';
const retired = records.retired;
---

<Base title="Not found — The Quiet Galaxy" description="This page does not exist, or does not exist yet." noindex>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>Nothing at these coordinates</h1>
    <p class="lede">
      The page you are looking for does not exist, or does not exist yet. The address of an explanation never changes once it is published, so a link that fails probably never pointed at one.
    </p>
    <p>
      Try the <a href="/">home page</a>, <a href="/equation/">the equation</a>, or <a href="/explanations/">the list of every explanation</a>.
    </p>
    {retired.length > 0 && (
      <p class="dim" style="font-size: 14.5px;">
        Pages that once existed and were retired: {retired.map((r, i) => (
          <>{r.id}{r.replaced_by ? <> (replaced by <a href={`/${r.kind === 'explanation' ? 'explanations' : r.kind === 'factor' ? 'factors' : r.kind === 'library' ? 'library/#' : 'story/#'}${r.kind === 'library' || r.kind === 'publication' ? r.replaced_by : r.replaced_by + '/'}`}>{r.replaced_by}</a>)</> : ''}{i < retired.length - 1 ? ', ' : '.'}</>
        ))}
      </p>
    )}
  </section>
</Base>
