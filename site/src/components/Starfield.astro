---
// Build-time starfield, copied from Sentient Horizons: positions are baked into
// the HTML at build time, so no client JavaScript ships.
interface Props {
  count?: number;
}
const { count = 140 } = Astro.props;

const stars = Array.from({ length: count }, () => ({
  x: +(Math.random() * 100).toFixed(2),
  y: +(Math.random() * 100).toFixed(2),
  size: Math.random() < 0.85 ? 1 : 2,
  opacity: +(0.1 + Math.random() * 0.7).toFixed(2),
  twinkle: Math.random() < 0.38,
  delay: +(Math.random() * 6).toFixed(2),
  dur: +(2.5 + Math.random() * 4.5).toFixed(2),
}));
---

<div class="starfield" aria-hidden="true">
  {stars.map((s) => (
    <span
      style={`left:${s.x}%;top:${s.y}%;width:${s.size}px;height:${s.size}px;opacity:${s.opacity};${s.twinkle ? `animation:twk ${s.dur}s ease-in-out ${s.delay}s infinite` : ''}`}
    ></span>
  ))}
</div>
