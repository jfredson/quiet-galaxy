---
// Site navigation, from the Sentient Horizons design standard (design/shell.html): the spine of
// the site in heavier ink, the reference pages lighter, the theme toggle last; collapses to a menu
// on small screens. Which page goes in which tier follows the tracker pattern
// (design/tracker-pattern.md, rule 4.6, ruled by John 2026-10-16), with the public names from the
// pattern's section 4. Cut to the pattern's two tiers on 2026-10-16, after the family design review
// of the same day found the site's name wrapping and the links spilling onto a second row at 1280
// pixels: the spine is the equation and the explanations; the library, the story so far, how the
// numbers are worked out and the disagree page sit behind the rule in the lighter tier (John's
// ruling, 2026-10-16). There is no Home link: the site's name links home, as the standard's
// section 6 says, and the bar has no room for a duplicate. The source link lives in the footer,
// as the standard's section 7 says. The disagree page is labelled "Disagree" here and keeps its
// full public name, "Disagree with something", as its title: with the full label the theme toggle
// still wrapped onto a second row at 1280 pixels (a judgment call, 2026-10-16; the alternative was
// tighter spacing on every link, three small departures from the standard's bar instead of one).
// "This week's reading" (added 2026-10-16 with the weekly reading) sits in the lighter tier after
// the story so far, not the heavier tier the pattern's rule 4.6 names, so the bar keeps to the
// ruling above; a judgment call, for John to move if he wants it on the spine.
const path = Astro.url.pathname;
const primary = [
  { href: '/equation/', label: 'The equation' },
  { href: '/explanations/', label: 'Explanations' },
];
const secondary = [
  { href: '/library/', label: 'Library' },
  { href: '/story/', label: 'The story so far' },
  { href: '/reading/', label: "This week's reading" },
  { href: '/method/', label: 'How the numbers are worked out' },
  { href: '/disagree/', label: 'Disagree' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href) || (href === '/equation/' && path.startsWith('/factors/')));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">The Quiet Galaxy</a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg class="ico-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      <svg class="ico-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <nav class="navlinks" id="site-nav">
      {primary.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      {secondary.map((l) => (
        <a href={l.href} class={`nav-secondary ${isActive(l.href) ? 'active' : ''}`}>{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var btn = header && header.querySelector('.nav-toggle');
    var menu = document.getElementById('site-nav');
    if (!btn || !menu) return;
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () { setOpen(!header.classList.contains('nav-open')); });
    menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    window.addEventListener('resize', function () { if (window.innerWidth > 1080) setOpen(false); });
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var meta = document.getElementById('theme-color-meta');
    var COLORS = { dark: '#05070a', light: '#f1f3f5' };
    function sync(theme) {
      document.documentElement.dataset.theme = theme;
      if (meta) meta.setAttribute('content', COLORS[theme] || COLORS.dark);
    }
    sync(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    btn.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync(next);
    });
  })();
</script>
