{
  // Cloudflare Workers config: a static-assets deployment, the same pattern as
  // beltequation.com, sentient-horizons.com and hearthandvoid.com. The custom domains
  // (thequietgalaxy.com and www) are added to "routes" once the domain is registered and
  // its zone is on this account; until then the site lives at its workers.dev address.
  "name": "quietgalaxy",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
